# Copier ce fichier en .env puis remplir les valeurs (ne jamais publier le .env)

# Adresse Gmail qui envoie les messages
GMAIL_USER=rahimdest@gmail.com

# Mot de passe d'application Gmail (16 caractères, PAS le mot de passe du compte)
# À créer sur https://myaccount.google.com/apppasswords (validation en 2 étapes requise)
GMAIL_APP_PASSWORD=

# Adresse qui reçoit les messages
MAIL_TO=rahimdest@gmail.com

# Sites autorisés à appeler l'API (séparés par des virgules)
ALLOWED_ORIGIN=https://abderrahim-meziane.github.io,http://127.0.0.1:5500
